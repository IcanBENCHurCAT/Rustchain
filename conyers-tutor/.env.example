# ═══════════════════════════════════════════════════════════════════════════
# Conyers Tutor — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is NOT checked into version control. See .gitignore.
# ═══════════════════════════════════════════════════════════════════════════

# ── Gemini API (required for proxy) ───────────────────────────────────
# Get key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Cloudflare Turnstile (optional — bot protection) ──────────────────
# Get site key from: https://developers.cloudflare.com/turnstile/getting-started/
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── Service Configuration ─────────────────────────────────────────────
# Proxy listen port
PORT=3001

# Run in mock mode (no API key needed, returns canned responses)
DEV_MODE=false

# ── Node Environment ──────────────────────────────────────────────────
NODE_ENV=production
